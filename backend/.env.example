APP_NAME=AI Resume Screening & Job Matching API
APP_VERSION=1.0.0
# Production defaults. Generate AUTH_SECRET and use HTTPS before serving traffic.
DEBUG=false
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/resume_matching
AUTH_SECRET=
AUTH_TOKEN_TTL_MINUTES=720
AUTH_COOKIE_SECURE=true
UPLOAD_STORAGE_DIR=/var/lib/ai-resume-screening/uploads
EMBEDDING_MODEL_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
EMBEDDING_LOCAL_FILES_ONLY=true
# Optional: Comma-separated list of allowed origins for cross-origin frontend (e.g. Vercel)
# CORS_ORIGINS=https://my-recruiter-portal.vercel.app
# SERVE_FRONTEND=true

